# Stratum environment variables
# Copy to .env and adjust values for your setup.

# --- Go API server ---

# HTTP listen port (default: 8080)
PORT=8080

# Postgres connection string (required)
# Development default uses docker-compose Postgres on port 5433
# (avoids conflict with a local Postgres install on 5432).
# Override POSTGRES_PORT in docker-compose if needed.
DATABASE_URL=postgres://stratum:stratum@localhost:5433/stratum?sslmode=disable

# Allowed CORS origins, comma-separated (default: http://localhost:3000)
# For production, restrict to your frontend URL:
#   ALLOWED_ORIGINS=https://stratum.example.com
ALLOWED_ORIGINS=http://localhost:3000

# Local Git endpoints read the API host's filesystem. Keep disabled for public deployments.
GIT_ENABLED=false

# --- Next.js frontend ---

# API server URL for the frontend (default: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Show the local Git tab. Keep aligned with the API's GIT_ENABLED setting.
NEXT_PUBLIC_GIT_ENABLED=false
