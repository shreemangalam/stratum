{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error",
				"noArrayIndexKey": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"files": {
		"includes": [
			"app/**",
			"components/**",
			"lib/**",
			"*.ts",
			"*.tsx",
			"*.mjs",
			"!!**/.next",
			"!!**/node_modules",
			"!!**/lib/api/generated"
		]
	}
}
